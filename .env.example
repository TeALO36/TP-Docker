# Facultatif : docker compose a des valeurs par défaut pour tout.
# Copier ce fichier en .env pour personnaliser (le .env n'est pas versionné).

HTTP_PORT=80

DB_NAME=pookie
DB_USER=pookie
DB_PASSWORD=pookie

REDIS_PASSWORD=pookie-redis

SESSION_SECRET=change-moi-en-production
PUBLIC_URL=http://pookie.localhost
